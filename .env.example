# BudgetThing Expo App - Environment Variables
# Copy this file to .env.local and fill in the values

# =============================================================================
# CLERK AUTHENTICATION
# =============================================================================
# Get this from: Clerk Dashboard → API Keys → Publishable Key
# Format: pk_test_xxxxxxxxxxxxx (dev) or pk_live_xxxxxxxxxxxxx (prod)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# =============================================================================
# CONVEX BACKEND
# =============================================================================
# Get this from: Running `npm run convex:dev` → prints deployment URL
# Format: https://xxxxx-xxxxx-xxx.convex.cloud
EXPO_PUBLIC_CONVEX_URL=https://REPLACE_ME.convex.cloud

# =============================================================================
# INSTRUCTIONS
# =============================================================================
# 1. Rename this file from .env.example to .env.local
# 2. Replace REPLACE_ME values with your actual keys
# 3. Restart the Expo dev server after making changes

# 
# WEB / PWA BROWSER TESTS (optional, local only)
# 
# Base address used to derive Clerk *test* emails (local+clerk_test_<suffix>@domain).
# Clerk development instances verify these with a fixed code; no email is sent.
E2E_CLERK_TEST_EMAIL_BASE=budgetthing-e2e@example.com
# Optional: lets @clerk/testing bypass bot protection. Server secret — never commit, never ship to the browser.
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
